# Copy to backend/.env and fill in. Never commit .env.
# Generate a key: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=change-me
DEBUG=True
# Comma-separated, no spaces
ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated, scheme required (e.g. Vite / Expo web dev servers)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081
